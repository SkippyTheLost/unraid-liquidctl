Menu="Utilities"
Title="liquidctl"
Icon="liquidctl.png"
---
<?php
$cfg = parse_plugin_cfg('liquidctl');
$enabled = $cfg['ENABLED'] ?? 'no';
$extraArgs = $cfg['EXTRA_ARGS'] ?? '';
$commandsFile = '/boot/config/plugins/liquidctl/startup.conf';
$commands = is_file($commandsFile) ? file_get_contents($commandsFile) : '';
$control = '/usr/local/emhttp/plugins/liquidctl/scripts/liquidctlctl';
$version = trim((string) shell_exec(escapeshellarg($control).' version 2>&1'));
?>

<h3>Installed version</h3>
<pre id="liquidctlVersion"><?=htmlspecialchars($version)?></pre>

<form id="liquidctlSettings" name="liquidctl_settings" onsubmit="return false">

<table class="settings">
  <tr>
    <td>Apply commands when Unraid starts:</td>
    <td>
      <select name="ENABLED">
        <?=mk_option($enabled, 'yes', 'Yes')?>
        <?=mk_option($enabled, 'no', 'No')?>
      </select>
    </td>
  </tr>
  <tr>
    <td>Global arguments:</td>
    <td><input type="text" name="EXTRA_ARGS" value="<?=htmlspecialchars($extraArgs, ENT_QUOTES)?>" placeholder="Optional"></td>
  </tr>
  <tr>
    <td>Startup commands:</td>
    <td>
      <textarea id="startupCommands" name="STARTUP_COMMANDS" rows="10" style="width:100%" spellcheck="false"><?=htmlspecialchars($commands, ENT_QUOTES)?></textarea>
      <blockquote>
        One command per line, without the leading <code>liquidctl</code>. Empty lines and lines beginning with # are ignored.
        See the <a href="https://github.com/liquidctl/liquidctl#readme" target="_blank" rel="noopener noreferrer">official liquidctl documentation</a>
        for commands and device-specific options.
      </blockquote>
    </td>
  </tr>
</table>

<div style="text-align:right">
  <input type="button" value="Apply" onclick="saveLiquidctl()">
  <input type="button" value="Run startup commands" onclick="runLiquidctl('apply')">
  <input type="button" value="Refresh devices" onclick="runLiquidctl('list')">
  <input type="button" value="Done" onclick="done()">
</div>
</form>

<h3>Detected devices</h3>
<pre id="liquidctlOutput" style="white-space:pre-wrap">Click Refresh devices to scan for liquidctl devices.</pre>

<script>
function saveLiquidctl() {
  const output = $('#liquidctlOutput');
  output.text('Saving...');
  $.post('/plugins/liquidctl/include/execute.php', {
    action: 'save',
    ENABLED: $('[name="ENABLED"]').val(),
    EXTRA_ARGS: $('[name="EXTRA_ARGS"]').val(),
    STARTUP_COMMANDS: $('#startupCommands').val()
  })
    .done(function(data) { output.text(data); })
    .fail(function(xhr) { output.text(xhr.responseText || 'Unable to save liquidctl settings.'); });
}

function runLiquidctl(action) {
  const output = document.getElementById('liquidctlOutput');
  output.textContent = 'Running...';
  $.post('/plugins/liquidctl/include/execute.php', {action: action})
    .done(function(data) { output.textContent = data; })
    .fail(function(xhr) { output.textContent = xhr.responseText || 'Command failed'; });
}
</script>

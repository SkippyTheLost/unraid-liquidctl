<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name       "liquidctl">
<!ENTITY author     "sk1pp">
<!ENTITY version    "2026.06.28">
<!ENTITY launch     "Settings/&name;">
<!ENTITY pluginURL  "https://github.com/SkippyTheLost/unraid-liquidctl/releases/latest/download/&name;.plg">
<!ENTITY bundle     "&name;-&version;.tgz">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="https://github.com/SkippyTheLost/unraid-liquidctl/issues">

<CHANGES>
### 2026.06.28
- Link the settings page to the official liquidctl documentation.
- Show the installed version at the top of the settings page.

### 2026.06.27.2
- Make settings saves immediate and remove device discovery from page load.

### 2026.06.27.1
- Fix saving startup commands and settings from the web interface.

### 2026.06.27
- Bundle a self-contained liquidctl executable and its Python dependencies.
- Register the page under Settings / User Utilities.
- Use native Unraid configuration storage and startup event handling.
</CHANGES>

<FILE Name="/boot/config/plugins/&name;/&bundle;">
<URL>"https://github.com/SkippyTheLost/unraid-liquidctl/releases/download/&version;/&bundle;"</URL>
</FILE>

<FILE Name="/boot/config/plugins/&name;/liquidctl.cfg">
<INLINE>
<![CDATA[
ENABLED="no"
EXTRA_ARGS=""
]]>
</INLINE>
</FILE>

<FILE Name="/boot/config/plugins/&name;/startup.conf">
<INLINE>
<![CDATA[
# initialize all
# set fan speed 30 40 50 60 70 80 90 100
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
set -e
[ -s /boot/config/plugins/&name;/&bundle; ] || {
  echo "Missing release bundle: /boot/config/plugins/&name;/&bundle;"
  exit 1
}
rm -rf /usr/local/emhttp/plugins/&name;
tar -xzf /boot/config/plugins/&name;/&bundle; -C /usr/local/emhttp/plugins
chmod 755 /usr/local/emhttp/plugins/&name;/bin/liquidctl
chmod 755 /usr/local/emhttp/plugins/&name;/scripts/liquidctlctl
chmod 755 /usr/local/emhttp/plugins/&name;/event/started
ln -sf /usr/local/emhttp/plugins/&name;/bin/liquidctl /usr/local/bin/liquidctl
echo "liquidctl &version; installed."
/usr/local/emhttp/plugins/&name;/scripts/liquidctlctl version
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -f /usr/local/bin/liquidctl
rm -rf /usr/local/emhttp/plugins/&name;
rm -f /boot/config/plugins/&name;/&name;-*.tgz
echo "liquidctl removed. Settings remain in /boot/config/plugins/&name;."
</INLINE>
</FILE>

</PLUGIN>
